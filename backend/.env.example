# Copy this file to ".env" and adjust as needed.

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (the URL you open the site from)
CLIENT_ORIGIN=http://localhost:5000

# MongoDB connection string.
# If this cannot be reached, the server automatically falls back to an
# in-memory MongoDB so the project still runs for a demo. Set
# USE_MEMORY_DB=true to force the in-memory database.
MONGO_URI=mongodb://127.0.0.1:27017/fashionhub
USE_MEMORY_DB=false

# JSON Web Token secret + lifetime. Change the secret in production.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Identity Services OAuth 2.0 Web client ID (public; configure authorized JS origins in Google Cloud)
GOOGLE_CLIENT_ID=

# Default admin created by the seed script
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@fashionhub.com
ADMIN_PASSWORD=use_a_unique_long_password_in_production

# Razorpay online checkout (test keys first; never expose the secret in frontend code)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional order confirmation email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
